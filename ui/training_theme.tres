[gd_resource type="Theme" load_steps=6 format=3]

[sub_resource type="SystemFont" id="Font"]
font_names = PackedStringArray("Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC")

[sub_resource type="StyleBoxFlat" id="Panel"]
bg_color = Color(0.035, 0.06, 0.08, 0.91)
content_margin_left = 20.0
content_margin_right = 20.0
content_margin_top = 14.0
content_margin_bottom = 14.0
border_width_left = 2
border_color = Color(0.38, 0.75, 0.7, 1)

[sub_resource type="StyleBoxFlat" id="Track"]
bg_color = Color(0.1, 0.15, 0.18, 1)

[sub_resource type="StyleBoxFlat" id="Fill"]
bg_color = Color(0.38, 0.75, 0.7, 1)

[sub_resource type="StyleBoxFlat" id="Button"]
bg_color = Color(0.15, 0.25, 0.29, 1)
content_margin_top = 12.0
content_margin_bottom = 12.0
content_margin_left = 18.0
content_margin_right = 18.0

[resource]
default_font = SubResource("Font")
default_font_size = 17
Label/colors/font_color = Color(0.9, 0.94, 0.95, 1)
Label/colors/font_shadow_color = Color(0, 0, 0, 0.65)
Label/constants/shadow_offset_x = 1
Label/constants/shadow_offset_y = 1
PanelContainer/styles/panel = SubResource("Panel")
ProgressBar/styles/background = SubResource("Track")
ProgressBar/styles/fill = SubResource("Fill")
Button/styles/normal = SubResource("Button")
Button/styles/hover = SubResource("Panel")
Button/styles/pressed = SubResource("Track")
Button/styles/focus = SubResource("Panel")
VBoxContainer/constants/separation = 8
HBoxContainer/constants/separation = 18
